# Example env for restdb.io-proxy
# If PROXY_API_KEY is set, incoming x-apikey must match
PROXY_API_KEY=
# MariaDB connection
MYSQL_ROOT_PASSWORD=root_pass
DB_USER=restdb_user
DB_PASSWORD=restdb_pass
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=restdb_proxy
# Optional: Full database URL (overrides host/port/user/password)
DATABASE_URL=
