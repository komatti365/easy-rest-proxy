# Example env for restdb.io-proxy
# If PROXY_API_KEY is set, incoming x-apikey must match
# You can also specify a mounted file instead of exposing the key directly:
# PROXY_API_KEY_FILE=/secrets/db_key.txt
PROXY_API_KEY=
# MariaDB connection
DB_USER=restdb_user
DB_PASSWORD=
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=restdb_proxy
# Optional: Full database URL (overrides host/port/user/password)
DATABASE_URL=
